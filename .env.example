# Cloudflare Workers AI — mantenha as credenciais apenas no ambiente local.
IMAGE_PROVIDER=cloudflare_workers_ai
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b
# Gemini planning: choose an available model supporting structured output.
GEMINI_API_KEY=
GEMINI_MODEL=
VOICESTUDIO_HOST=127.0.0.1
VOICESTUDIO_PORT=3901
OUTPUT_WIDTH=1080
OUTPUT_HEIGHT=1920
OUTPUT_FPS=30
MIN_DURATION_SECONDS=15

# Effective provider/runtime selectors; keep paths and approved profile IDs local.
MOTION_VOICE_URL=http://127.0.0.1:3901
MOTION_VOICE_DEVICE=
# Optional: all worktrees must share the same absolute GPU lock and voice cache.
# MOTION_GPU_LOCK=
# MOTION_VOICE_CACHE=
