{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "request": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "kind": {
      "enum": [
        "creation",
        "edit",
        "cut",
        "motion",
        "review",
        "update"
      ]
    },
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "purpose": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "audience": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "sources": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "language": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "format": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "width": {
                  "type": "integer",
                  "minimum": 16
                },
                "height": {
                  "type": "integer",
                  "minimum": 16
                },
                "fps": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "video_codec": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "audio_codec": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "pixel_format": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "required": [
                "width",
                "height",
                "fps",
                "video_codec",
                "audio_codec",
                "pixel_format"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "duration_seconds": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "voice": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "enum": [
                    "none",
                    "original",
                    "narration"
                  ]
                },
                "profile_id": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "authorized": {
                  "type": "boolean"
                }
              },
              "required": [
                "mode",
                "profile_id",
                "authorized"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "captions": {
          "anyOf": [
            {
              "enum": [
                "none",
                "authored",
                "speech"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "music": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "effects": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "deadline": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "external": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "allowed": {
                  "type": "boolean"
                },
                "providers": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  }
                },
                "max_cost": {
                  "type": "number",
                  "minimum": 0
                },
                "currency": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "private_upload": {
                  "type": "boolean"
                }
              },
              "required": [
                "allowed",
                "providers",
                "max_cost",
                "currency",
                "private_upload"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "delivery": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "folder": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "editable": {
                  "type": "boolean"
                },
                "files": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  }
                }
              },
              "required": [
                "folder",
                "editable",
                "files"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "purpose",
        "audience",
        "sources",
        "language",
        "format",
        "duration_seconds",
        "references",
        "voice",
        "captions",
        "music",
        "effects",
        "deadline",
        "external",
        "delivery"
      ]
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "license": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "model": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          },
          "prompt": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          },
          "destination": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "approved": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "sha256",
          "source",
          "license",
          "model",
          "prompt",
          "destination",
          "approved"
        ]
      }
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "objective": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "script": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "template_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "assets": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "new_asset_reason": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          },
          "asset_strategy": {
            "enum": [
              "reuse",
              "synthetic",
              "local-gpu",
              "external"
            ]
          },
          "provider": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          }
        },
        "required": [
          "id",
          "objective",
          "script",
          "template_id",
          "assets",
          "new_asset_reason",
          "asset_strategy",
          "provider"
        ]
      }
    },
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "plan": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "sample": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "editonny_card": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "summary": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "shown_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "reply": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "replied_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "message_id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "required": [
                "summary",
                "shown_at",
                "reply",
                "replied_at",
                "message_id"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "plan",
        "sample",
        "editonny_card"
      ]
    },
    "reviews": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "visual": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "pending",
                "passed",
                "not_applicable"
              ]
            },
            "reviewer": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                {
                  "type": "null"
                }
              ]
            },
            "evidence": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "status",
            "reviewer",
            "evidence"
          ]
        },
        "listening": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "pending",
                "passed",
                "not_applicable"
              ]
            },
            "reviewer": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                {
                  "type": "null"
                }
              ]
            },
            "evidence": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "status",
            "reviewer",
            "evidence"
          ]
        },
        "sync": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "pending",
                "passed",
                "not_applicable"
              ]
            },
            "reviewer": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                {
                  "type": "null"
                }
              ]
            },
            "evidence": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "status",
            "reviewer",
            "evidence"
          ]
        },
        "captions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "pending",
                "passed",
                "not_applicable"
              ]
            },
            "reviewer": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                {
                  "type": "null"
                }
              ]
            },
            "evidence": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "status",
            "reviewer",
            "evidence"
          ]
        },
        "playback": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "pending",
                "passed",
                "not_applicable"
              ]
            },
            "reviewer": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                {
                  "type": "null"
                }
              ]
            },
            "evidence": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "status",
            "reviewer",
            "evidence"
          ]
        },
        "rights": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "pending",
                "passed",
                "not_applicable"
              ]
            },
            "reviewer": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                {
                  "type": "null"
                }
              ]
            },
            "evidence": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "status",
            "reviewer",
            "evidence"
          ]
        }
      },
      "required": [
        "visual",
        "listening",
        "sync",
        "captions",
        "playback",
        "rights"
      ]
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "request",
    "kind",
    "brief",
    "assets",
    "scenes",
    "approvals",
    "reviews"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Production request v1 — orchestration, not renderer props"
}
