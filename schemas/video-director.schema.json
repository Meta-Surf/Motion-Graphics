{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Motion director v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "title",
    "video_type",
    "fps",
    "voice",
    "art_direction",
    "scenes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "\\S"
    },
    "video_type": {
      "enum": [
        "short_9_16",
        "long_16_9"
      ]
    },
    "fps": {
      "enum": [
        24,
        25,
        30,
        60
      ]
    },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "\\S"
        },
        "steps": {
          "enum": [
            16,
            32
          ]
        }
      }
    },
    "art_direction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "palette",
        "lighting",
        "camera",
        "continuity"
      ],
      "properties": {
        "palette": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "\\S"
        },
        "lighting": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "\\S"
        },
        "camera": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "\\S"
        },
        "continuity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "\\S"
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "template_id",
          "title",
          "narration_text",
          "image_prompt",
          "seed"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
          },
          "template_id": {
            "enum": [
              "photo_essay",
              "layers",
              "object3d",
              "dataflow",
              "cutaway",
              "scale",
              "compare"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 70,
            "pattern": "\\S"
          },
          "narration_text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000,
            "pattern": "\\S"
          },
          "image_prompt": {
            "type": "string",
            "minLength": 30,
            "maxLength": 2200,
            "pattern": "\\S"
          },
          "seed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "duration_seconds": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 120
          },
          "labels": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 28,
              "pattern": "\\S"
            }
          }
        }
      }
    }
  }
}
