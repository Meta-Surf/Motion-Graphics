{
  "name": "motion-graphics-remotion",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render:demo": "remotion render src/index.ts AiShort renders/ai-short-demo.mp4",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/*.test.ts",
    "compositions": "remotion compositions src/index.ts",
    "render:library": "remotion render src/index.ts MotionLibraryDemo renders/motion-library.mp4",
    "gpu:check": "remotion gpu --gl=angle",
    "preview:library": "node scripts-render-preview.mjs",
    "render:amf": "node render-amf.mjs",
    "render:study": "remotion render src/index.ts ReferenceMotionStudy renders/reference-study.mp4",
    "render:breakdown": "remotion render src/index.ts LayerBreakdown renders/layer-breakdown.mp4",
    "prepare:editorial": "python ../scripts/make_editorial_demo_audio.py",
    "render:editorial": "npm run prepare:editorial && remotion render src/index.ts EditorialPatternDemo renders/editorial-patterns.mp4"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "@remotion/bundler": "4.0.538",
    "@remotion/captions": "4.0.538",
    "@remotion/cli": "4.0.538",
    "@remotion/media-utils": "4.0.538",
    "@remotion/motion-blur": "4.0.538",
    "@remotion/renderer": "4.0.538",
    "@remotion/three": "4.0.538",
    "@remotion/transitions": "4.0.538",
    "@types/three": "0.186.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.538",
    "zod": "4.5.4",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/react": "19.1.8",
    "typescript": "5.8.3"
  },
  "overrides": {
    "zod": "4.5.4"
  }
}
